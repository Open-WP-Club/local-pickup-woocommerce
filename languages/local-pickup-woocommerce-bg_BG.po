msgid "Pickup locations"
msgstr "Обекти за вземане"

msgid "Pickup location"
msgstr "Обект за вземане"

msgid "Add pickup location"
msgstr "Добавяне на обект"

msgid "Edit pickup location"
msgstr "Редактиране на обект"

msgid "Location details"
msgstr "Данни за обекта"

msgid "Street address"
msgstr "Адрес"

msgid "City"
msgstr "Град"

msgid "State / County"
msgstr "Област"

msgid "Postcode"
msgstr "Пощенски код"

msgid "Phone"
msgstr "Телефон"

msgid "Phone:"
msgstr "Телефон:"

msgid "Opening hours"
msgstr "Работно време"

msgid "Opening hours:"
msgstr "Работно време:"

msgid "Pickup price"
msgstr "Цена за вземане"

msgid "Leave empty or enter 0 for free pickup. The store currency is used."
msgstr "Оставете празно или въведете 0 за безплатно вземане. Използва се валутата на магазина."

msgid "Country / Region"
msgstr "Държава / Регион"

msgid "Tax status"
msgstr "Данъчен статус"

msgid "Taxable"
msgstr "Облагаем"

msgid "None"
msgstr "Без"

msgid "Status"
msgstr "Статус"

msgid "Enable this pickup location"
msgstr "Активиране на този обект"

msgid "Location"
msgstr "Обект"

msgid "Address"
msgstr "Адрес"

msgid "Price"
msgstr "Цена"

msgid "Free"
msgstr "Безплатно"

msgid "Enabled"
msgstr "Активен"

msgid "Disabled"
msgstr "Неактивен"

msgid "Store pickup"
msgstr "Вземане от магазин"

msgid "Let customers collect their order from a selected store or pickup location."
msgstr "Позволява на клиентите да вземат поръчката си от избран магазин или обект."

msgid "Enable/Disable"
msgstr "Активиране/Деактивиране"

msgid "Enable store pickup for this shipping zone"
msgstr "Активиране на вземането от магазин за тази зона"

msgid "Method title"
msgstr "Име на метода"

msgid "Shown to customers in the Checkout Block."
msgstr "Показва се на клиентите в Checkout Block."

msgid "Available locations"
msgstr "Достъпни обекти"

msgid "Choose the locations available in this zone. Leave empty to use every enabled location."
msgstr "Изберете достъпните обекти за тази зона. Оставете празно, за да използвате всички активни обекти."

msgid "Default location"
msgstr "Обект по подразбиране"

msgid "First available location"
msgstr "Първият достъпен обект"

msgid "This location is selected first when pickup is initially chosen. It must also be available in this zone."
msgstr "Този обект се избира първи при първоначален избор на вземане. Той трябва да е достъпен и за тази зона."

msgid "View in Google Maps"
msgstr "Вижте в Google Maps"

msgid "Google Maps:"
msgstr "Google Maps:"

msgid "Please select a valid pickup location before placing your order."
msgstr "Моля, изберете валиден обект за вземане, преди да завършите поръчката."

msgid "Select a pickup location"
msgstr "Изберете обект за вземане"

msgid "Local Pickup Stores requires WooCommerce to be installed and active."
msgstr "Local Pickup Stores изисква WooCommerce да бъде инсталиран и активен."
